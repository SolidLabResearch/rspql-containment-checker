{
    "name": "rspql-containment-checker",
    "version": "2.7.1",
    "description": "Tool determining the containment relation in between two RSPQL queries.",
    "main": "dist/index.js",
    "bin": {"rspql-containment-checker": "dist/cli.js"},
    "scripts": {
        "build": "npx tsc",
        "build:specs": "node scripts/build-specs.js",
        "install": "npm run build:specs",
        "prepare": "npm run build && npm run build:specs",
        "prepack": "npm run build && npm run build:specs",
        "start": "node dist/index.js",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "lint:ts": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
        "release": "npm run build && npm publish --access public"
    },
    "keywords": [],
    "author": "Kushagra Singh Bisen",
    "license": "ISC",
    "files": [
        "dist",
        "specs/src/Makefile",
        "specs/src/lexer.lex",
        "specs/src/main.cpp",
        "specs/src/parser.tab.cpp",
        "specs/src/parser.tab.hpp",
        "specs/src/parser.ypp",
        "specs/src/query.cpp",
        "specs/src/query.hpp",
        "specs/src/rdf.cpp",
        "specs/src/rdf.hpp",
        "specs/src/lex.yy.c",
        "scripts/build-specs.js"
    ],
    "devDependencies": {
        "@types/jest": "^29.2.4",
        "jest": "^29.3.1",
        "supertest": "^6.3.3",
        "ts-jest": "^29.0.3",
        "@typescript-eslint/parser": "^6.21.0",
        "esdoc": "^1.1.0",
        "eslint": "^8.56.0",
        "eslint-plugin-jest": "^27.8.0",
        "eslint-plugin-jsdoc": "^48.0.6",
        "typescript": "^4.9.4"
    },
    "dependencies": {
        "@types/bunyan": "^1.8.11",
        "bunyan": "^1.8.15",
        "commander": "^13.1.0",
        "rspql-query-isomorphism": "^2.0.0",
        "sparqljs": "^3.7.3"
    }
}
